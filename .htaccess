# Vybtek Wedding — static site (Apache / cPanel).
# The backend/API is served separately by vybtek-back at /api/wedvyb.

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Clean URLs: /services also works when /services.html exists.
  # (Existing internal links use .html and keep working directly — no forced redirect.)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ── Caching ──────────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css              "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png             "access plus 30 days"
  ExpiresByType image/jpeg            "access plus 30 days"
  ExpiresByType image/webp            "access plus 30 days"
  ExpiresByType image/svg+xml         "access plus 30 days"
  ExpiresByType text/html             "access plus 0 seconds"
</IfModule>

# ── Gzip compression ─────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# ── Security headers ─────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
